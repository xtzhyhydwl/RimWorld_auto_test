# ── 隔离测试环境（游戏运行时数据，很大且可重建）──
profiles/

# ── 测试产物（报告、截图、缓存的调试动作树）──
runs/

# ── 依赖与构建产物 ──
node_modules/
bridge/**/bin/
bridge/**/obj/
bridge/**/*.dll
bridge/**/*.pdb
mods/**/obj/
mods/**/bin/

# ── 调研中间产物 ──
.research/
tmp/

# ── 脚本运行期输出（一次性脚本的产物；结论已整理进 docs/mod列表整理-结论.md）──
data/

# ── 编辑器/系统 ──
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

# 拉取的第三方仓库（随时会被上游更新，不进本仓库）
/RimworldMods/

# 测试产物与报告（体积大、可重生成）
/reports/

# 文档只留在磁盘，不进 git（本仓库只放主要代码）
/docs/

# 工作区文件
/RHAH.code-workspace
