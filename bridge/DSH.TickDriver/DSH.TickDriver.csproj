<Project Sdk="Microsoft.NET.Sdk">

  <!-- DSH.TickDriver：桥接伴生 DLL（RimBridgeServer BridgeTools 插件），给游戏加一条
       「在游戏内部闭环推到某个 tick」的命令。做法与 bridge\DSH.CEBridge 完全一致：
       SDK 风格 net10.0 工程，产物 DSH.TickDriver.dll 由 `dotnet build -c Release` 产出后
       拷到本目录（游戏侧 BridgeTools\DSH.TickDriver 是指向本目录的 junction）。 -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DSH.TickDriver</AssemblyName>
    <RootNamespace>DSH.TickDriver</RootNamespace>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <!-- 游戏根目录（1.7 把托管程序集平铺在这里：Assembly-CSharp.dll / UnityStubs.dll）。换机器改这一行或传 /p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\RimWorld</GameDir>
    <!-- 桥接 SDK：伴生 DLL 只认桥接进程里已加载的那一份，所以引用游戏侧实际部署的 dll。 -->
    <RimBridgeServerDir Condition="'$(RimBridgeServerDir)' == ''">D:\SteamLibrary\steamapps\common\RimWorld\Mods\RimBridgeServer\1.6\Assemblies</RimBridgeServerDir>
    <!-- Harmony：游戏里那份由 brrainz.harmony 提供；只借它的 HarmonyLib 类型，运行时不额外带 dll。 -->
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">D:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies</HarmonyDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TickDriver.cs" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimBridgeServer.Sdk">
      <HintPath>$(RimBridgeServerDir)\RimBridgeServer.Sdk.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
