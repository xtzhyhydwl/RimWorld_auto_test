<?xml version="1.0" encoding="utf-8"?>
<!--
  BikeProbe · RecipeDef（探针 C1）
  目的：在锻造台造出一个 **物品形态** 的车，验证「RecipeDef.products → 自定义 MinifiedThing 子类」
  这条路能不能跑通（原版没有任何 RecipeDef 产出 MinifiedThing 的先例，见设计 v2 §2.3）。
  ⚠ 如果 C1 失败，本配方会造出来就自毁 + 刷红字
     （RimWorld.MinifiedThing::Tick 里 `if (InnerThing == null) Log.Error("MinifiedThing with null InnerThing. Destroying.")`）。
     这是预期的“响亮失败”，不要靠猜符号绕过去。
-->
<Defs>

  <RecipeDef>
    <defName>Make_ProbeBike</defName>
    <label>make probe bike</label>
    <description>把 10 钢铁打成一辆打包的探针单车。探针用配方。</description>
    <jobString>Making probe bike.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>500</workAmount>
    <workSkill>Crafting</workSkill>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ProbeBikeMinified>1</ProbeBikeMinified>
    </products>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
  </RecipeDef>

</Defs>
