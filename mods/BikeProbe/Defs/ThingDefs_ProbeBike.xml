<?xml version="1.0" encoding="utf-8"?>
<!--
  BikeProbe · ThingDefs
  探针 A2 / C1 / C3 的载体：
    · ProbeBike          = 建筑形态（可 Uninstall / 可被整理工收起）
    · ProbeBikeMinified  = 物品形态（ParentName="MinifiedThing" + 自定义 thingClass）
      ⚠ 真值表 §8 / 设计 v2 §2.3：PostMake 在 Verse.Thing 上（不在 ThingComp 上），
        所以 MinifiedBike 覆写的是 Verse.Thing::PostMake。原版先例 = MinifiedTree（Items_Unfinished.xml）。
      ⚠ Mass = 7 ⇒ 1.0 BodySize 的人理论上一背 5 辆（MassUtility.Capacity = BodySize × 35）。
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>ProbeBike</defName>
    <label>probe bike</label>
    <description>探针用共享单车的“建筑形态”。用完即弃，不是产品内容。</description>
    <thingClass>BikeProbe.ProbeBike</thingClass>
    <minifiedDef>ProbeBikeMinified</minifiedDef>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <useHitPoints>true</useHitPoints>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <designationCategory>Production</designationCategory>
    <costList>
      <Steel>10</Steel>
    </costList>
    <building>
      <uninstallWork>20</uninstallWork>
      <alwaysUninstallable>true</alwaysUninstallable>
      <isInert>true</isInert>
    </building>
    <statBases>
      <Mass>7</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>10</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Production/TableMachining</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="MinifiedThing">
    <defName>ProbeBikeMinified</defName>
    <label>probe bike (packed)</label>
    <description>探针用共享单车的“物品形态”。</description>
    <thingClass>BikeProbe.MinifiedBike</thingClass>
    <statBases>
      <Mass>7</Mass>
    </statBases>
  </ThingDef>

  <!--
    C3 对照组（2026-10-13 run-2 新增）：Mass = 0 的同形状探针车。
    为什么需要它：C3 的判据是"背包 innerContainer 的**实际计数**"，
    而 run-1 的探针"一次 Job 只 TryAdd 一辆 + 链尾清空背包"⇒ 结构上无法累积。
    本轮把 Job 改成"逐辆收完再放下"之后，还需要一个**不会被质量闸门卡住**的对象
    才能把"容器/Job 循环本身有没有隐性上限"与"质量闸门"两件事分开：
      · ProbeBike（Mass=7）→ 期望恰好卡在第 6 辆（Capacity = BodySize × 35）
      · ProbeBikeMassless（Mass=0）→ 期望能一路收到 N 辆，若它也卡住 ⇒ 瓶颈不在质量
    ⚠ 这是**探针工具 def**，不是产品 def；也没有顺手改 ProbeBike 自身的 Mass。
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>ProbeBikeMassless</defName>
    <label>probe bike (massless control)</label>
    <description>C3 对照组：Mass=0 的探针车。用完即弃，不是产品内容。</description>
    <thingClass>BikeProbe.ProbeBike</thingClass>
    <minifiedDef>ProbeBikeMinified</minifiedDef>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <useHitPoints>true</useHitPoints>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <designationCategory>Production</designationCategory>
    <costList>
      <Steel>10</Steel>
    </costList>
    <building>
      <uninstallWork>20</uninstallWork>
      <alwaysUninstallable>true</alwaysUninstallable>
      <isInert>true</isInert>
    </building>
    <statBases>
      <Mass>0</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>10</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Production/TableMachining</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>

</Defs>
