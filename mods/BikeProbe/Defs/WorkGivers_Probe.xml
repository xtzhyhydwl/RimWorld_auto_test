<?xml version="1.0" encoding="utf-8"?>
<!--
  BikeProbe · WorkGiverDef（探针 A2 / A4）
  ⚠ 真值表 §2.2：缺 <verb> / <gerund> 会直接红字（RimWorld.WorkGiverDef::ConfigErrors）。
  ⚠ workType 必须指向上面的 ProbeBikeTidying，否则这个 WorkGiver 永远不进任何人的 workGiversInOrder。
-->
<Defs>

  <WorkGiverDef>
    <defName>ProbeBikeTidy</defName>
    <label>tidy probe bikes</label>
    <giverClass>BikeProbe.Probe_WorkGiver_Tidy</giverClass>
    <workType>ProbeBikeTidying</workType>
    <verb>tidy</verb>
    <gerund>tidying</gerund>
    <priorityInType>10</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
