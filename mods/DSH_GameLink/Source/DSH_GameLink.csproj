<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 1.7（Waylith / .NET 10）编译链。原来这里是 net472 + 直接引用游戏 RimWorldWin64_Data\Managed\ 里的程序集；
         1.7 更新把那个目录删了，托管程序集平铺在**游戏根目录**，Unity 也只剩 UnityStubs.dll
         ⇒ net472 那条链在这台机器上已无法重建。改法见 docs\RimWorld-1.7模组侧适配-20261024.md §3.4 / §5。
         net10.0 的 BCL 由 SDK 的 packs\Microsoft.NETCore.App.Ref 提供，所以下面不再引用 mscorlib/System/netstandard。 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DSH_GameLink</AssemblyName>
    <RootNamespace>DSH_GameLink</RootNamespace>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NuGetAudit>false</NuGetAudit>
    <OutputPath>..\Assemblies\</OutputPath>
    <!-- 游戏根目录（1.7 的 Assembly-CSharp.dll / UnityStubs.dll 就在这里）。换机器时改这一行或传 /p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\RimWorld</GameDir>
    <!-- Harmony：运行靠 Harmony mod（About.xml 已依赖 brrainz.harmony），编译只借它的 dll。
         1.7 的 Harmony 是 3.0.0.0，在工坊 Harmony mod 的 1.7\Assemblies 下。换机器时改这一行或传 /p:HarmonyDir=... -->
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">D:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies</HarmonyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 心跳用 UnityEngine.Time.realtimeSinceStartup：1.7 没有 UnityEngine.*Module，Unity 被 UnityStubs 取代
         （RimWorld.runtimeconfig.json 里有 UnityEngine*=UnityStubs 的重定向）。 -->
    <Reference Include="UnityStubs">
      <HintPath>$(GameDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
