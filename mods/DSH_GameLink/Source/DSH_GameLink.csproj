<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 和 VoiceDeputy / BikeProbe 同一套路：1.6 跑在 Unity 的 Mono 上（net472 谱系），
         本机没装 net472 目标包也不拉 NuGet 包，所以 /nostdlib+ + 直接引用游戏 Managed\ 里的程序集，
         保证基础库和游戏运行时是同一套。 -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DSH_GameLink</AssemblyName>
    <RootNamespace>DSH_GameLink</RootNamespace>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NuGetAudit>false</NuGetAudit>
    <OutputPath>..\Assemblies\</OutputPath>
    <!-- 游戏目录写在这里；换机器时改这一行或传 /p:RimWorldManagedDir=... -->
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">D:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <!-- Harmony：运行靠 Harmony mod（About.xml 已依赖 brrainz.harmony），编译只借它的 dll；
         游戏自带 Managed\ 里没有 0Harmony.dll。换机器时改这一行或传 /p:HarmonyDir=... -->
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">D:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.6\Assemblies</HarmonyDir>
    <!-- 这两个私有属性填上，GetReferenceAssemblyPaths 就不会去找 net472 目标包（否则 MSB3644） -->
    <_TargetFrameworkDirectories>$(RimWorldManagedDir)</_TargetFrameworkDirectories>
    <_FullFrameworkReferenceAssemblyPaths>$(RimWorldManagedDir)</_FullFrameworkReferenceAssemblyPaths>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib">
      <HintPath>$(RimWorldManagedDir)\mscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(RimWorldManagedDir)\System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(RimWorldManagedDir)\System.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(RimWorldManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 心跳用 UnityEngine.Time.realtimeSinceStartup：主菜单里没有 tick，只能靠实时时间。 -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
